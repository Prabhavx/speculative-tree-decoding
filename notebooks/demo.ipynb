{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Speculative Decoding Demo\n",
    "\n",
    "This notebook demonstrates the chain-based speculative decoding engine."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "import sys\n",
    "sys.path.append('..')\n",
    "\n",
    "from speculative_tree_decoding.models import load_models\n",
    "from speculative_tree_decoding.engine import SpeculativeDecodingEngine, autoregressive_generate\n",
    "\n",
    "print(f\"PyTorch: {torch.__version__}\")\n",
    "print(f\"CUDA available: {torch.cuda.is_available()}\")\n",
    "if torch.cuda.is_available():\n",
    "    print(f\"GPU: {torch.cuda.get_device_name(0)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load models (using small models for demo)\n",
    "draft_name = \"Qwen/Qwen2.5-0.5B-Instruct\"\n",
    "target_name = \"Qwen/Qwen2.5-1.5B-Instruct\"\n",
    "\n",
    "draft_model, target_model, tokenizer = load_models(\n",
    "    draft_name, target_name,\n",
    "    device=\"cuda\" if torch.cuda.is_available() else \"cpu\",\n",
    "    dtype=torch.float16 if torch.cuda.is_available() else torch.float32,\n",
    ")\n",
    "\n",
    "device = next(draft_model.parameters()).device\n",
    "print(f\"Models loaded on {device}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create engine\n",
    "engine = SpeculativeDecodingEngine(\n",
    "    draft_model,\n",
    "    target_model,\n",
    "    tokenizer,\n",
    "    gamma=4,\n",
    "    temperature=0.7,\n",
    "    top_p=0.9,\n",
    ")\n",
    "\n",
    "prompt = \"Write a short poem about programming:\"\n",
    "\n",
    "# Speculative generation\n",
    "import time\n",
    "torch.cuda.synchronize() if torch.cuda.is_available() else None\n",
    "start = time.time()\n",
    "spec_output = engine.generate(prompt, max_new_tokens=50)\n",
    "torch.cuda.synchronize() if torch.cuda.is_available() else None\n",
    "spec_time = time.time() - start\n",
    "\n",
    "# Autoregressive baseline\n",
    "torch.cuda.synchronize() if torch.cuda.is_available() else None\n",
    "start = time.time()\n",
    "ar_output = autoregressive_generate(\n",
    "    target_model, tokenizer, prompt,\n",
    "    max_new_tokens=50,\n",
    "    temperature=0.7, top_p=0.9,\n",
    "    device=device\n",
    ")\n",
    "torch.cuda.synchronize() if torch.cuda.is_available() else None\n",
    "ar_time = time.time() - start\n",
    "\n",
    "print(f\"Prompt: {prompt}\")\n",
    "print(f\"\\nSpeculative ({spec_time:.3f}s):\")\n",
    "print(spec_output)\n",
    "print(f\"\\nAutoregressive ({ar_time:.3f}s):\")\n",
    "print(ar_output)\n",
    "print(f\"\\nSpeedup: {ar_time/spec_time:.2f}x\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test greedy mode (deterministic)\n",
    "engine_greedy = SpeculativeDecodingEngine(\n",
    "    draft_model, target_model, tokenizer,\n",
    "    gamma=4,\n",
    "    temperature=0.0,\n",
    ")\n",
    "\n",
    "prompt = \"The capital of France is\"\n",
    "spec_greedy = engine_greedy.generate(prompt, max_new_tokens=20)\n",
    ar_greedy = autoregressive_generate(\n",
    "    target_model, tokenizer, prompt,\n",
    "    max_new_tokens=20,\n",
    "    temperature=0.0,\n",
    "    device=device\n",
    ")\n",
    "\n",
    print(f\"Prompt: {prompt}\")\n",
    print(f\"Speculative greedy: {spec_greedy}\")\n",
    print(f\"Autoregressive greedy: {ar_greedy}\")\n",
    print(f\"Match: {spec_greedy == ar_greedy}\")"
   ]
  }
 ],
